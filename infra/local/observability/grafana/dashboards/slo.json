{
  "uid": "outlet-slo",
  "title": "Z-OUTLET SLOs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "slo"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Checkout success (SLO 99.5%)",
      "description": "successes / attempts, 1h window",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:checkout_error_ratio:rate1h",
          "legendFormat": "success ratio 1h"
        },
        {
          "refId": "B",
          "expr": "1 - slo:checkout_error_ratio:rate6h",
          "legendFormat": "success ratio 6h"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Webhook to PAID p95 (SLO < 5 s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(webhook_to_paid_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API read p95 (SLO < 300 ms)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(api_read_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reserve p95 (SLO < 150 ms)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(reserve_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Unmatched PSP lines older than 3 days (SLO 0)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(unmatched_psp_lines)",
          "legendFormat": "unmatched"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error-budget burn rate (x)",
      "description": "error ratio / budget; fast alert at 14.4x, slow at 6x",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:checkout_error_ratio:rate1h / 0.005",
          "legendFormat": "checkout 1h"
        },
        {
          "refId": "B",
          "expr": "slo:checkout_error_ratio:rate6h / 0.005",
          "legendFormat": "checkout 6h"
        }
      ]
    },
    {
      "id": 7,
      "type": "text",
      "title": "Crash-free sessions (SLO 99.8%)",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "mode": "markdown",
        "content": "Mobile and web crash-free rate comes from Sentry (release health), not OTel. See docs/runbooks/observability.md."
      }
    }
  ]
}