{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Outlet NK / Checkout",
  "uid": "outlet-checkout",
  "tags": [
    "outlet-nk",
    "generated",
    "skeleton"
  ],
  "schemaVersion": 39,
  "timezone": "Africa/Cairo",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Checkout success: SLI over 28d",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:sli_error:ratio_rate28d{slo=\"checkout-success\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Checkout success: error budget remaining (28d)",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (slo:sli_error:ratio_rate28d{slo=\"checkout-success\"} / 0.005)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Checkout success: error ratio against alert thresholds",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate1h{slo=\"checkout-success\"}",
          "legendFormat": "1h error ratio"
        },
        {
          "refId": "B",
          "expr": "slo:sli_error:ratio_rate6h{slo=\"checkout-success\"}",
          "legendFormat": "6h error ratio"
        },
        {
          "refId": "C",
          "expr": "vector(0.0672)",
          "legendFormat": "fast threshold (burn 13.44x)"
        },
        {
          "refId": "D",
          "expr": "vector(0.028)",
          "legendFormat": "slow threshold (burn 5.6x)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Attempts by outcome",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(outlet_checkout_attempts_total[5m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failures by reason",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (failure_reason) (rate(outlet_checkout_attempts_total{outcome=\"failed\"}[15m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Attempts by payment method",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (payment_method) (rate(outlet_checkout_attempts_total[15m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Reservation expiry before payment",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(outlet_reservation_expired_total{reason=\"payment_window\"}[15m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}
