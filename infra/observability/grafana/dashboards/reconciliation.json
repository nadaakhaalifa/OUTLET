{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Outlet NK / Reconciliation and refunds",
  "uid": "outlet-reconciliation",
  "tags": [
    "outlet-nk",
    "generated",
    "skeleton"
  ],
  "schemaVersion": 39,
  "timezone": "Africa/Cairo",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Refund initiation within 24 h: SLI over 28d",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:sli_error:ratio_rate28d{slo=\"refund-initiation\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Refund initiation within 24 h: error budget remaining (28d)",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (slo:sli_error:ratio_rate28d{slo=\"refund-initiation\"} / 0.01)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Refund initiation within 24 h: error ratio against alert thresholds",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate1h{slo=\"refund-initiation\"}",
          "legendFormat": "1h error ratio"
        },
        {
          "refId": "B",
          "expr": "slo:sli_error:ratio_rate6h{slo=\"refund-initiation\"}",
          "legendFormat": "6h error ratio"
        },
        {
          "refId": "C",
          "expr": "vector(0.1344)",
          "legendFormat": "fast threshold (burn 13.44x)"
        },
        {
          "refId": "D",
          "expr": "vector(0.056)",
          "legendFormat": "slow threshold (burn 5.6x)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unmatched PSP lines older than 3 days: current",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(outlet_reconciliation_unmatched_lines{age_bucket=\"gt_3d\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Unmatched lines by age bucket",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (age_bucket) (outlet_reconciliation_unmatched_lines)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unmatched amount (EGP minor units)",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(outlet_reconciliation_unmatched_amount_minor)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Seconds since last successful run",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(outlet_reconciliation_last_success_timestamp_seconds)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Refunds by SLA outcome",
      "description": "SKELETON: panel layout and thresholds are placeholders until the metric is instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(outlet_refund_sla_total[1h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}
