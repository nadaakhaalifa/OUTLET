{
  "uid": "outlet-outbox",
  "title": "Outbox lag",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "outlet",
    "slo"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Oldest unpublished event age",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(outlet_outbox_lag_seconds)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Relay job runs",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(outlet_worker_job_runs_total{job=~\".*outbox.*\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
