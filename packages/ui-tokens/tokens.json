  "elevation": {
    "0": {
      "$type": "shadow",
      "$value": "none"
    },
    "1": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(26,32,28,0.08)"
    },
    "2": {
      "$type": "shadow",
      "$value": "0 4px 12px rgba(26,32,28,0.10)"
    },
    "3": {
      "$type": "shadow",
      "$value": "0 12px 32px rgba(26,32,28,0.14)"
    },
    "$description": "Dark theme: use border.default plus bg.surface steps instead of shadows; elevation 2-3 shadows use rgba(0,0,0,0.5)."
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "0ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "200ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0.2,
          1
        ]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    },
    "reduced": {
      "$description": "When prefers-reduced-motion is set: use these. No parallax, no momentum auto-scroll, no auto-advance on carousels; swaps become fades.",
      "duration": {
        "$type": "duration",
        "$value": "0ms"
      },
      "fade": {
        "$type": "duration",
        "$value": "100ms"
      }
    }
  },
  "breakpoint": {
    "sm": {
