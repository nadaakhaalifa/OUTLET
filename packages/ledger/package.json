{
  "name": "@outlet/ledger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mutation": "cd ../.. && stryker run packages/ledger/stryker.config.mjs --concurrency 2"
  },
  "dependencies": {
    "@outlet/db": "workspace:*",
    "@outlet/idempotency": "workspace:*",
    "@outlet/ids": "workspace:*",
    "@outlet/money": "workspace:*",
    "@outlet/outbox": "workspace:*",
    "zod": "^4.6.7"
  }
}
