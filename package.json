{
  "name": "outlet-nk",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "mutation": "cd packages/domain && stryker run ../../stryker.config.mjs",
    "i18n-check": "node .github/scripts/i18n-check.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "turbo": "^2.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
