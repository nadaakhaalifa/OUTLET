#!/bin/sh
# Fail closed: a missing scanner blocks the commit (BUILD-PROMPT section 2).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Install it (macOS: brew install gitleaks) and retry." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --config .gitleaks.toml --no-banner
