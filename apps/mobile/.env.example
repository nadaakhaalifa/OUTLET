# Copy to .env.local (git-ignored). Restart Expo with `npx expo start -c` after changing values.

# Real API (leave unset to use in-memory fixtures in development; release builds require it).
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Development only: local background-removal sidecar (start it with tooling/media/run-sidecar.sh).
# Ignored in release builds and whenever EXPO_PUBLIC_API_BASE_URL is set.
# Allowed: http://127.0.0.1, http://localhost, http://10.x.x.x, http://192.168.x.x
EXPO_PUBLIC_DEV_CUTOUT_URL=http://127.0.0.1:8099
