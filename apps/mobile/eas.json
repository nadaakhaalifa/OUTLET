{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": { "node": "24.0.0" },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000", "EAS_UPDATE_CHANNEL": "development" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "staging",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE-staging-api.example.invalid", "EAS_UPDATE_CHANNEL": "staging" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE-prod-api.example.invalid", "EAS_UPDATE_CHANNEL": "production" }
    }
  },
  "submit": { "production": { "ios": {}, "android": { "track": "internal" } } }
}
