# Local-only placeholders. No real secrets. Copy to .env (git-ignored).
# Runtime: through PgBouncer (transaction mode), app role (RLS applies).
DATABASE_URL=postgresql://outlet_app:app_local_only@127.0.0.1:6432/outlet_catalog
# Checkout/reserve path: isolated pool, same backend DB. Set SET LOCAL statement_timeout='2s' per transaction.
DATABASE_URL_CHECKOUT=postgresql://outlet_app:app_local_only@127.0.0.1:6432/outlet_checkout
# Pre-auth endpoints (/v1/auth/*): outlet_auth role, own pool (ADR-0011).
DATABASE_URL_AUTH=postgresql://outlet_auth:auth_local_only@127.0.0.1:6432/outlet_auth
# Workers (outbox relay, privacy deletion/retention, auth purge): outlet_worker role, own pool.
DATABASE_URL_WORKER=postgresql://outlet_worker:worker_local_only@127.0.0.1:6432/outlet_worker
# Migrations and psql: direct to Postgres as owner role (never through the pooler).
DATABASE_URL_DIRECT=postgresql://outlet_migrator:migrator_local_only@127.0.0.1:5432/outlet_dev
REDIS_URL=redis://127.0.0.1:6379
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
